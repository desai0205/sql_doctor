<div class="page-header">
  <h1 class="page-title">Analysis History</h1>
  <a href="/" class="btn btn--primary">New Analysis</a>
</div>

<% if @analyses.empty? %>
  <div class="empty-state">
    <div class="empty-state-icon">🩺</div>
    <p>No analyses yet. <a href="/">Analyze your first query.</a></p>
  </div>
<% else %>
  <div class="history-list">
    <% @analyses.each do |analysis| %>
      <div class="history-item card">
        <div class="history-item-top">
          <a href="<%= analysis_path(analysis) %>" class="history-item-link">
            <div class="history-item-meta">
              <span class="badge"><%= analysis.db_type %></span>
              <% if analysis.risk_score.present? %>
                <%= risk_badge(analysis.risk_score) %>
              <% end %>
              <span class="history-item-date"><%= analysis.created_at.strftime("%b %d, %Y %H:%M") %></span>
            </div>
            <pre class="history-item-query"><%= truncate(analysis.sql_query, length: 160) %></pre>
            <p class="history-item-explanation"><%= truncate(analysis.explanation, length: 120) %></p>
          </a>
          <%= button_to "Delete", analysis_path(analysis), method: :delete, class: "btn btn--danger btn--sm", data: { turbo_confirm: "Delete this analysis?" } %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
