# Ignore bundler config
/.bundle

# Ignore all logfiles and tempfiles
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage
/storage/*
!/storage/.keep

# Ignore uploaded files in development
/public/uploads

# Ignore master key for decrypting credentials
/config/master.key

# Ignore environment variables
.env
.env.*

# Ignore Ruby dependencies
/vendor/bundle

# Ignore IDE/editor files
.idea/
.vscode/
*.swp
*.swo

# Ignore macOS files
.DS_Store

# Ignore Node dependencies
/node_modules
