<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SQLDoctor – AI SQL Analyzer</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", media: "all" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body>
    <header class="header">
      <div class="container">
        <a href="/" class="logo">
          <span class="logo-icon">⚕</span>
          <span class="logo-text">SQL<strong>Doctor</strong></span>
        </a>
        <nav>
          <a href="/" class="nav-link">New Analysis</a>
          <a href="/analyses" class="nav-link">History</a>
        </nav>
      </div>
    </header>

    <main class="main">
      <div class="container">
        <% if flash[:alert] %>
          <div class="flash flash--alert"><%= flash[:alert] %></div>
        <% end %>
        <% if flash[:notice] %>
          <div class="flash flash--notice"><%= flash[:notice] %></div>
        <% end %>
        <%= yield %>
      </div>
    </main>

    <footer class="footer">
      <div class="container">
        <p>SQLDoctor — AI-powered SQL analysis</p>
      </div>
    </footer>
  </body>
</html>
